{
  "name": "n8n-nodes-iflytek",
  "version": "0.1.0",
  "description": "n8n community nodes for iFLYTEK skills: TTS, OCR, translation, speech transcription, and multimodal understanding.",
  "keywords": [
    "n8n-community-node-package",
    "iflytek",
    "xfyun",
    "tts",
    "ocr",
    "translation",
    "speech-to-text"
  ],
  "license": "Apache-2.0",
  "author": "iFLYTEK",
  "engines": {
    "node": ">=18.10"
  },
  "main": "index.js",
  "scripts": {
    "generate": "python scripts/generate_nodes.py",
    "bundle-skills": "node scripts/bundle-skills.js",
    "build": "npm run bundle-skills && tsc && gulp build:icons",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "skills"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/IflyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Translate/Translate.node.js",
      "dist/nodes/Proofread/Proofread.node.js",
      "dist/nodes/HyperTts/HyperTts.node.js",
      "dist/nodes/ImageUnderstanding/ImageUnderstanding.node.js",
      "dist/nodes/OcrInvoice/OcrInvoice.node.js",
      "dist/nodes/ImageOcr/ImageOcr.node.js",
      "dist/nodes/PdfOcr/PdfOcr.node.js",
      "dist/nodes/Transcribe/Transcribe.node.js",
      "dist/nodes/VoicecloneSynth/VoicecloneSynth.node.js",
      "dist/nodes/VideoTranslate/VideoTranslate.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.120.19",
    "typescript": "5.4"
  }
}
