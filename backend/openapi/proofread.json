{
  "openapi": "3.0.1",
  "info": {
    "title": "iFLYTEK proofread",
    "description": "Chinese official-document proofreading and error correction.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://example.com"
    }
  ],
  "paths": {
    "/skills/proofread": {
      "post": {
        "operationId": "proofread",
        "summary": "Chinese official-document proofreading and error correction.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "Text to proofread. Provide either text or file."
                  },
                  "file": {
                    "type": "string",
                    "description": "Path to a UTF-8 text file to proofread instead of inline text."
                  },
                  "raw": {
                    "type": "boolean",
                    "description": "Return the raw (decoded) JSON API response.",
                    "default": false
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Skill result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "output": {
                      "type": "string"
                    },
                    "artifact_url": {
                      "type": "string"
                    },
                    "task_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}